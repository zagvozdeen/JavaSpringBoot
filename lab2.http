### 01. Все поля
POST http://localhost:8082/feedback
Content-Type: application/json

{
  "uid": "1",
  "operationUid": "operation-1",
  "systemName": "ERP",
  "systemTime": "2026-09-27T10:00:00.000Z",
  "source": "IDEA",
  "communicationId": 100,
  "templateId": 8,
  "productCode": 1500,
  "smsCode": 10
}

> {%
client.test("Все поля", function () {
    client.assert(response.status === 200, "Ожидался HTTP 200");
    client.assert(response.body.code === "success", "Неверный code");
    client.assert(response.body.errorCode === "", "Неверный errorCode");
    client.assert(response.body.uid === "1", "Неверный uid");
    client.assert(response.body.operationUid === "operation-1", "Неверный operationUid");
});
%}

### 02. Только обязательные поля
POST http://localhost:8082/feedback
Content-Type: application/json

{
  "uid": "1",
  "operationUid": "operation-1",
  "systemTime": "2026-09-27T10:00:00.000Z",
  "communicationId": 100
}

> {%
client.test("Только обязательные поля", function () {
    client.assert(response.status === 200, "Ожидался HTTP 200");
    client.assert(response.body.code === "success", "Неверный code");
    client.assert(response.body.errorCode === "", "Неверный errorCode");
    client.assert(response.body.uid === "1", "Неверный uid");
    client.assert(response.body.operationUid === "operation-1", "Неверный operationUid");
});
%}

### 03. uid отсутствует
POST http://localhost:8082/feedback
Content-Type: application/json

{
  "operationUid": "operation-1",
  "systemTime": "2026-09-27T10:00:00.000Z",
  "communicationId": 100
}

> {%
client.test("uid отсутствует", function () {
    client.assert(response.status === 400, "Ожидался HTTP 400");
    client.assert(response.body.code === "failed", "Неверный code");
    client.assert(response.body.errorCode === "ValidationException", "Неверный errorCode");
});
%}

