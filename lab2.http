### 25. Неподдерживаемый uid = 123
POST http://localhost:8082/feedback
Content-Type: application/json

{
  "uid": "123",
  "operationUid": "operation-1",
  "systemTime": "2026-09-27T10:00:00.000Z",
  "communicationId": 100
}

> {%
client.test("Неподдерживаемый uid = 123", function () {
    client.assert(response.status === 400, "Ожидался HTTP 400");
    client.assert(response.body.code === "failed", "Неверный code");
    client.assert(response.body.errorCode === "UnsupportedCodeException", "Неверный errorCode");
});
%}

### 26. Несколько ошибок одновременно
POST http://localhost:8082/feedback
Content-Type: application/json

{
  "uid": "",
  "operationUid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
  "systemTime": "   ",
  "communicationId": 0
}

> {%
client.test("Несколько ошибок одновременно", function () {
    client.assert(response.status === 400, "Ожидался HTTP 400");
    client.assert(response.body.code === "failed", "Неверный code");
    client.assert(response.body.errorCode === "ValidationException", "Неверный errorCode");
});
%}
